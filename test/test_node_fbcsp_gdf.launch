<launch>

    <arg name="gdf_file"      default="$(find processing_bci)/test/prova32ch.gdf"/>
    <arg name="samplerate"    default="512"/>
    <arg name="framerate"     default="16"/>
    <arg name="paradigm"      default="mi"/>
    <arg name="run_mode"      default="online"/>
    <arg name="signal_type"   default="eeg"/>
    <arg name="filter_order"  default="4"/>
    <arg name="filters_band"  default="8.0 10.0; 10.0 12.0; 12.0 14.0; 8.0 14; 14.0 20.0;"/>
    <arg name="do_ica"        default="false"/>
    <arg name="do_car"        default="true"/>

    <!-- rosneuro_acquisition replaying a GDF file via eegdev datafile plugin -->
    <node name="acquisition" pkg="rosneuro_acquisition" type="acquisition" output="screen">
        <param name="~plugin"     value="rosneuro::EGDDevice"/>
        <param name="~devarg"     value="$(arg gdf_file)"/>
        <param name="~samplerate" value="$(arg samplerate)"/>
        <param name="~framerate"  value="$(arg framerate)"/>
    </node>

    <rosparam command="load" file="$(find processing_bci)/cfg/ringbuffer.yaml" subst_value="true"/>
    <rosparam command="load" file="$(find processing_bci)/cfg/car.yaml" if="$(arg do_car)"/>

    <!-- FBCSP processing node — CSP yaml loaded inside for private namespace -->
    <node name="processing_fbcsp_node" pkg="processing_bci" type="processing_fbcsp_node" output="screen">
        <param name="nchannels"    value="32"/>
        <param name="chunkSize"    value="$(eval int(arg('samplerate')) / int(arg('framerate')))"/>
        <param name="samplerate"   value="$(arg samplerate)"/>
        <param name="filter_order" value="$(arg filter_order)"/>
        <param name="run_mode"     value="$(arg run_mode)"/>
        <param name="signal_type"  value="$(arg signal_type)"/>
        <param name="filters_band" value="$(arg filters_band)"/>
        <param name="do_ica"       value="$(arg do_ica)"/>
        <param name="do_car"       value="$(arg do_car)"/>
        <param name="topic_to_pub" value="/$(arg paradigm)/eeg_fbcsp"/>
        <rosparam command="load" file="$(find processing_bci)/cfg/csp/mi/csp_test.yaml"/>
    </node>

    <!-- Logger: saves seq-indexed features + first_seq offset -->
    <node pkg="processing_bci" type="test_logger_fbcsp_processing_bci"
          name="test_logger_fbcsp" output="screen">
        <param name="output_filename" value="$(find processing_bci)/test/fbcsp_gdf_output.csv"/>
        <param name="topic"           value="/$(arg paradigm)/eeg_fbcsp"/>
    </node>

</launch>
